# Copy to .env and fill with real values. Never commit .env.
# Every value below is a dummy placeholder.

# Project masking secret. At least 32 characters of real entropy.
# Env-only by design: there is no CLI flag, so it stays out of shell history and ps output.
# The same secret always produces the same masked values; changing it changes every value.
DBMASK_SECRET=replace-with-32-plus-chars-of-entropy

# Database dbmask masks in place (init, check, mask, verify).
DBMASK_URL=postgresql+psycopg://dbmask:dbmask@localhost:54329/dbmask_staging

# Pump source (read-only session) and pump target (must be empty).
DBMASK_SOURCE_URL=postgresql+psycopg://dbmask:dbmask@localhost:54329/dbmask_source
DBMASK_TARGET_URL=mysql+pymysql://dbmask:dbmask@localhost:33069/dbmask_staging
